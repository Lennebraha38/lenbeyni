# ZenAI ortam degiskenleri — ornek. Gercek dosya .env olarak adlandirilir ve gitignore'dadir.

# OpenRouter anahtari (web sunucusu rolede ve tam_zirve benchmark'inda kullanilir)
OPENROUTER_KEY=sk-or-v1-XXXX

# Yerel model (Ollama) - Server guild / offline modda
OLLAMA_URL=http://localhost:11434

# Benchmark cikti dosyasi (varsayilan: /tmp/opencode/zirve_sonuc.json)
# LB_CIKTI=/tmp/opencode/zirve_sonuc.json

# Benchmark acil modeli (429 koti durumunda): ZIRVE_MODEL=openai/gpt-4o-mini
# ZIRVE_MODEL=

# Web rolesi guvenligi (Vercel env):
# CORS allowlist (virgulle ayrilmis): ZENAI_ORIGIN=https://zenai-two.vercel.app
# Opsiyonel koruma tokeni (tanimlarsan role her istekte ister):
# ZENAI_ACCESS_TOKEN=ornek-gizli-token